@using Ams_Web.Models;
@model bodofficer_ViewModel

@{
    ViewData["Title"] = "Bod Officer";
}

<div class="supplier-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="supplier-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1 text-uppercase">BOD / Officer</h5>
                <p class="text-secondary mb-0 fs-6">
                    BOD / Officer information and allowances.
                </p>
            </div>
        </div>
        <a data-bs-toggle="modal"
           data-bs-target="#createbodofficer"
           id="btnOpencreatebodofficer"
           onclick="opencreatebodofficerModal()"
           class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Add New Bod / Officer
        </a>
    </div>
    <div class="card bodofficer-card">
        <div class="table-responsive table-scroll" style="min-height: 600px">
            <table class="table align-middle bodofficer-table mb-0 ">
                <thead>
                    <tr>
                        <th class="ps-4">Id</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bodofficer in Model._bodofficerList_Dtos)
                    {
                        <tr>
                            <td>@bodofficer!.CombinationId</td>
                            <td>@bodofficer!.Name</td>
                            <td>@bodofficer.TypeDesc</td>
                            <td class="text-center pe-4 ">
                                <a data-selid="@bodofficer.Id"
                                   data-selname="@bodofficer.Name"
                                   data-seltype="@bodofficer.TypeId"
                                   
                                   class="btn btn-sm btn-info action-btn openupdate_modal"
                                   title="Update Details">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a data-selallowanceid="@bodofficer.Id"
                                   data-selallowancename="@bodofficer.Name"
                                   class="btn btn-sm btn-primary open_allowance"
                                   title="Allowance">
                                    Allowance
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_CreateBodOfficer")
@await Html.PartialAsync("_UpdateBodOfficer")
@await Html.PartialAsync("_BodOfficerAllowance")