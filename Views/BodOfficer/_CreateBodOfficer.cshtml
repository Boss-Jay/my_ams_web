@using Ams_Web.Models;
@model bodofficer_ViewModel

<div class="modal fade"
     id="createbodofficer"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ">
        <form asp-action="Create_BodOfficer" id="frmcreatebofofficer">
            <div class="modal-container">
                <div class="modal-wrapper">
                    <div class="card modal-content">
                        <div class="card-header">
                            <h2 class="card-title">
                                New BOD / Officer
                            </h2>
                            <p class="card-description">
                                Enter the  BOD / Officer  information .
                            </p>
                        </div>
                        <div class="card-body">
                            <div class="form-section">
                               
                                <div class="form-group">
                                    <label asp-for="_bodofficerCreate_Dto.Name"> </label>
                                    <input type="text"
                                           asp-for="_bodofficerCreate_Dto.Name" />
                                </div>
                                <div class="form-group">
                                    <label asp-for="_bodofficerCreate_Dto.TypeId"> </label>
                                    <select asp-for="_bodofficerCreate_Dto.TypeId">
                                        <option value=""></option>
                                        <option value="1">Board of Directors</option>
                                        <option value="2">Officer</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancel
                            </button>
                            <button type="submit" id="btncreatebodofficer"
                                    class="btn btn-primary">
                                <i class="bi bi-person-fill-add"></i>
                                Create
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>