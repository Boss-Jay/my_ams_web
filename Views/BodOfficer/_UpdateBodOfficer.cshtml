@using Ams_Web.Models;
@model bodofficer_ViewModel

<div class="modal fade"
     id="updatebodofficer"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ">

        <div class="modal-container">
            <div class="modal-wrapper">
                <div class="card modal-content">
                    <div class="card-header">
                        <h2 class="card-title">
                            Update BOD / Officer
                        </h2>
                        <p class="card-description">
                           Edit BOD / Officer  information .
                        </p>
                    </div>
                    <div class="card-body">
                        <div class="form-section">
                            <input type="text" id="upbodofficerid" hidden/>
                            <div class="form-group">
                                <label asp-for="_bodofficerCreate_Dto.Name"> </label>
                                <input type="text" id="upbodofficername" />
                            </div>
                            <div class="form-group">
                                <label asp-for="_bodofficerCreate_Dto.TypeId"> </label>
                                <select id="upbodofficertype">
                                    <option value=""></option>
                                    <option value="1">Board of Directors</option>
                                    <option value="2">Officer</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>
                            Cancel
                        </button>
                        <button type="submit"
                                onclick="Update_BODOfficer()"
                                class="btn btn-primary">
                            <i class="bi bi-person-fill-add"></i>
                            Update
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>