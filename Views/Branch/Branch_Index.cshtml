@using Ams_Web.Models;
@model branch_ViewModel

@{
    ViewData["Title"] = "Branch List";
}

<div class="user-page">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="page-icon">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1 text-uppercase">Branch</h5>
                <p class="text-secondary mb-0 fs-6">
                    Manage branch informations and status.
                </p>
            </div>
        </div>

        <a data-bs-toggle="modal"
           data-bs-target="#createbranch"
           id="btnOpencreatebranch"
           onclick="opencreatebranchModal()"
           class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Add New Branch
        </a>
    </div>
    <div class="card branch-card">
        <div class="table-responsive table-scroll" style="min-height: 600px">
            <table class="table align-middle branch-table mb-0 ">
                <thead>
                    <tr>
                        <th class="ps-4">Branch Name</th>
                        <th>Company</th>
                        <th>Address</th>
                        <th>Manager</th>
                        <th>Accountant</th>
                        <th>Contact #</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.branchList_Dtos!)
                    {
                        <tr>
                            <td>@item!.Name</td>
                            <td>@item.CompanyName</td>
                            <td>@item!.Address</td>
                            <td>@item.ManagerName</td>
                            <td>@item.AccountantName</td>
                            <td>@item.Contact1</td>
                            <td class="text-center">
                                <a data-bs-toggle="modal"
                                   data-bs-target="#updatebranch"
                                   id="btnOpenupdatebranch"
                                   onclick="Get_Branch(@item.Branchid)"
                                   class="btn btn-sm btn-light action-btn"
                                   title="Update Branch">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@await Html.PartialAsync("_Create_Branch")
@await Html.PartialAsync("_Update_Branch")