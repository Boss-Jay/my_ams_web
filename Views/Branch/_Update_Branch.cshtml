@using Ams_Web.Models;
@model branch_ViewModel

<div class="modal fade"
     id="updatebranch"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ">

        <div class="page-container">
            <div class="registration-wrapper">
                <div class="card modal-content">
                    <div class="card-header">
                        <h2 class="card-title">
                            New Branch
                        </h2>
                        <p class="card-description">
                            Enter the branch's  information .
                        </p>

                    </div>
                    <div class="card-body">
                        <input id="branchid" hidden />

                        <div class="form-section">
                            <div class="section-title">
                                <i class="bi bi-building"></i>
                                Branch Information
                            </div>
                            <div class="form-group">
                                <label>Company</label>
                                <select id="branchcompany"
                                        asp-items="ViewBag.vbcompany" class="w-100">
                                    <option value="">
                                        Select Company
                                    </option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label> Name</label>
                                <input id="branchname" placeholder="Tondo">
                            </div>

                            <div class="form-group">
                                <label> Address</label>
                                <input id="branchaddress"
                                          placeholder="Looc Mandaue City ">
                                         
                            </div>

                            <div class="form-group">
                                <label>Zipcode </label>
                                <input type="text" id="branchzipcode" class="w-25"
                                       placeholder="6010">
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label> Email </label>
                                    <input id="branchemail1">
                                </div>
                                <div class="form-group">
                                    <label> Email </label>
                                    <input id="branchemail2">
                                </div>
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label> T I N </label>
                                    <input id="branchtin">
                                </div>
                                <div class="form-group">
                                    <label> CODE </label>
                                    <input id="branchcode">
                                </div>
                            </div>
                        </div>
                        <div class="form-section">
                            <div class="section-title">
                                <i class="bi bi-telephone"></i>
                                Contact / Inline Person
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label> Contact #1 </label>
                                    <input id="branchcontact1">
                                </div>
                                <div class="form-group">
                                    <label> Contact #1 </label>
                                    <input id="branchcontact2">
                                </div>
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label>Manager</label>
                                    <select id="branchmanager"
                                            asp-items="ViewBag.vbuserlisting" class="w-100">
                                        <option value="">
                                            Select User
                                        </option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Accountant</label>
                                    <select id="branchaccountant"
                                            asp-items="ViewBag.vbuserlisting" class="w-100">
                                        <option value="">
                                            Select User
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-section">
                            <div class="section-title">
                                <i class="bi bi-upc"></i>
                                Code
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label> OCN </label>
                                    <input id="branchocn">
                                </div>
                                <div class="form-group">
                                    <label> RDO </label>
                                    <input id="branchrdo">
                                </div>
                            </div>
                        </div>

                        <div class="card-footer">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancel
                            </button>
                            <button type="submit" id="btnupdatebranch"
                                    onclick="Update_Branch()"
                                    class="btn btn-primary">
                                <i class="bi bi-building-exclamation"></i>
                                Update Branch
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
