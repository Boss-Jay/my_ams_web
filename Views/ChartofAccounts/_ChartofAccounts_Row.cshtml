@using Ams_Web.Dto;
@model coaTree_Dto


@{
    int level = Convert.ToInt32(ViewData["Level"] ?? 0);
    string? parentId = ViewData["ParentId"]?.ToString();
    bool hasChildren = Model.Children.Any();
}

<tr class="account-row"
    data-account-id="@Model.CoaId"
    data-parent-id="@parentId"
    data-level="@level"
    style="@(level > 0 ? "display: none;" : "")">

    <td>@Model.CoaId</td>

    <td>
        <span class="account-description"
              style="padding-left: @(level * 25)px">

            @if (hasChildren)
            {
                <button type="button"
                        class="toggle-account btn action-btn btn-primary"
                        aria-expanded="false"
                        title="Expand account">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <i class="bi bi-folder ms-1 me-2"></i>
            }
            else
            {
                <span class="account-toggle-placeholder"></span>
                <i class="bi bi-file-earmark ms-1 me-2 text-muted"></i>
            }

            @Model.CoaDesc
        </span>
    </td>
    <td class="text-center pe-4">
        <a data-bs-toggle="modal"
           data-bs-target="#editaccountitle"
           id="btneditaccounttitle"
         
           class="btn btn-sm btn-light action-btn"
           title="Edit Account">
            <i class="bi bi-pencil-square"></i>
        </a>
        <a @* data-bs-toggle="modal"
           data-bs-target="#createaccounttitle" *@
           id="btncreateaccounttitle"
           class="btn btn-sm btn-light action-btn open-account"
           data-coaid="@Model.CoaId"
           data-account-desc="@Model.CoaDesc"
           data-level="@Model.Level"
           
           title="Add Sub Account Title">
            <i class="bi bi-file-earmark-plus"></i>
        </a>
    </td>
</tr>

@foreach (var child in Model.Children)
{
    @await Html.PartialAsync(
    "_ChartofAccounts_Row",
        child,
        new ViewDataDictionary(ViewData)
        {
            ["Level"] = level + 1,
            ["ParentId"] = Model.CoaId
        })
}
