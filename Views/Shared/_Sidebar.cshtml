@using Microsoft.AspNetCore.Http

@inject IHttpContextAccessor HttpContextAccessor
@{
    var fullname = HttpContextAccessor.HttpContext?.Session.GetString("lastname") + ", " +
    HttpContextAccessor.HttpContext?.Session.GetString("firstname") + " " +
    HttpContextAccessor.HttpContext?.Session.GetString("middlename")!.Substring(0, 1) + ".";
}
<aside class="app-sidebar" id="sidebar">


    <!-- HEADER -->

    <div class="sidebar-header">

        <div class="app-logo">

            <i class="bi bi-clipboard-data"></i>

        </div>


        <span class="app-name">

            A M S

        </span>
    </div>


    <!-- DATABASE-DRIVEN BRANCH DROPDOWN -->
    @await Component.InvokeAsync("BranchSidebar")

    <div class="sidebar-content">


        <div class="menu-label">

            MAIN

        </div>


        <!-- DASHBOARD -->

        <a href="#"
           class="sidebar-item ">

            <i class="bi bi-speedometer2"></i>

            <span>
                Dashboard
            </span>

        </a>

        <!-- MASTER DATA -->

        <div class="sidebar-group">
            <button type="button" class="sidebar-item sidebar-dropdown">
                <i class="bi bi-database"></i>
                <span>
                    Master Data
                </span>
                <i class="bi bi-chevron-right menu-arrow"></i>
            </button>
            <div class="submenu">
                <a asp-action="Supplier_Index" asp-controller="Supplier"
                   class="submenu-item">
                    <i class="bi bi-people"></i>
                    <span>Supplier</span>
                </a> 
                <a asp-action="Tenants_Index" asp-controller="Tenants"
                         class="submenu-item">
                    <i class="bi bi-house-heart"></i>
                    <span>Tenants</span>
                </a>
                <a asp-action="BodOfficer_Index" asp-controller="BodOfficer"
                   class="submenu-item">
                    <i class="bi bi-people-fill"></i>
                    <span>BOD & Officer</span>
                </a>
            </div>
        </div>
        <a asp-action="ChartofAccounts_Index" asp-controller="ChartofAccounts"
           class="sidebar-item">

            <i class="bi bi-graph-up-arrow"></i>

            <span>
                Chart of Accounts
            </span>

        </a>

        <!-- TRANSACTIONS -->

        <div class="sidebar-group">
            <button type="button"
                    class="sidebar-item sidebar-dropdown">
                <i class="bi bi-arrow-left-right"></i>
                <span>
                    Transactions
                </span>
                <i class="bi bi-chevron-right menu-arrow"></i>
            </button>

            <div class="submenu">
                <a asp-action="AccountRecon_Index" asp-controller="AccountRecon"
                   class="submenu-item">
                    <i class="bi bi-ticket-detailed"></i>
                    <span>
                        Account Reconciliation
                    </span>
                </a>
                <a href="#"
                   class="submenu-item">
                    <i class="bi bi-credit-card"></i>
                    <span>
                        Check Register
                    </span>
                </a>
                <a href="#"
                   class="submenu-item">

                    <i class="bi bi-pencil-square"></i>

                    <span>
                        Vat Output
                    </span>
                </a>
            </div>
        </div>

        <!-- REPORTS -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-item sidebar-dropdown">

                <i class="bi bi-bar-chart"></i>

                <span>
                    Reports
                </span>

                <i class="bi bi-chevron-right menu-arrow"></i>

            </button>


            <div class="submenu">


                <a href="#"
                   class="submenu-item">

                    <i class="bi bi-graph-up"></i>

                    <span>
                        Sales Report
                    </span>

                </a>


                <a href="#"
                   class="submenu-item">

                    <i class="bi bi-calculator"></i>

                    <span>
                        Accounting Report
                    </span>

                </a>


            </div>

        </div>



        <div class="menu-label">

            SYSTEM

        </div>


        <!-- SETTINGS -->

        <a href="#"
           class="sidebar-item">

            <i class="bi bi-gear"></i>

            <span>
                Settings
            </span>

        </a>


        <!-- USERS -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-item sidebar-dropdown">

                <i class="bi bi-people"></i>

                <span>
                    Administrator
                </span>

                <i class="bi bi-chevron-right menu-arrow"></i>

            </button>

            <div class="submenu">

                <a asp-action="User_Index" asp-controller="User"
                   class="submenu-item">

                    <i class="bi bi-person"></i>

                    <span>
                        User Account & Access
                    </span>

                </a>

                <a asp-action="Branch_Index" asp-controller="Branch"
                   class="submenu-item">
                    <i class="bi bi-building-fill"></i>
                    <span>
                        Branch
                    </span>

                </a>

            </div>

        </div>


    </div>



    <!-- FOOTER -->

    <div class="sidebar-footer">


        <a asp-controller="Login" asp-action="Logout"
           class="sidebar-item-footer ">

            <i class="bi bi-box-arrow-right"></i>

            <span>
                LOG OUT - @fullname
            </span>

        </a>


    </div>


</aside>
