@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var fullname = HttpContextAccessor.HttpContext?.Session.GetString("lastname")+", "+
    HttpContextAccessor.HttpContext?.Session.GetString("firstname") + " " +
    HttpContextAccessor.HttpContext?.Session.GetString("middlename")!.Substring(0,1)+".";
}
<aside class="app-sidebar" id="sidebar">


    <!-- HEADER -->

    <div class="sidebar-header">

        <div class="app-logo">

            <i class="bi bi-clipboard-data"></i>

        </div>


        <span class="app-name">

            A M S

        </span>
    </div>

    <div class="branch-container">


        <span class="branch-label">

            CURRENT BRANCH

        </span>


        <div class="branch-selector">


            <!-- SELECTED BRANCH -->

            <button type="button"
                    class="branch-button"
                    id="branchButton">


                <div class="branch-icon">

                    <i class="bi bi-building"></i>

                </div>


                <div class="branch-info">

                    <span class="branch-title">
                        Branch
                    </span>

                    <span class="branch-name"
                          id="currentBranch">

                        Cebu

                    </span>

                </div>


                <i class="bi bi-chevron-down branch-arrow"></i>


            </button>



            <!-- BRANCH OPTIONS -->

            <div class="branch-menu"
                 id="branchMenu">


                <!-- CEBU -->

                <button type="button"
                        class="branch-option selected"
                        data-branch="Cebu">

                    <div class="branch-option-icon">

                        <i class="bi bi-building"></i>

                    </div>

                    <div class="branch-option-info">

                        <div class="branch-option-name">

                            Cebu

                        </div>

                        <div class="branch-option-location">

                            Main Branch

                        </div>

                    </div>

                    <i class="bi bi-check2 branch-check"></i>

                </button>



                <!-- MANDAUE -->

                <button type="button"
                        class="branch-option"
                        data-branch="Mandaue">

                    <div class="branch-option-icon">

                        <i class="bi bi-building"></i>

                    </div>

                    <div class="branch-option-info">

                        <div class="branch-option-name">

                            Mandaue

                        </div>

                        <div class="branch-option-location">

                            Mandaue Branch

                        </div>

                    </div>

                    <i class="bi bi-check2 branch-check"></i>

                </button>



                <!-- LAPU-LAPU -->

                <button type="button"
                        class="branch-option"
                        data-branch="Lapu-Lapu">

                    <div class="branch-option-icon">

                        <i class="bi bi-building"></i>

                    </div>

                    <div class="branch-option-info">

                        <div class="branch-option-name">

                            Lapu-Lapu

                        </div>

                        <div class="branch-option-location">

                            Lapu-Lapu Branch

                        </div>

                    </div>

                    <i class="bi bi-check2 branch-check"></i>

                </button>



                <!-- BOHOL -->

                <button type="button"
                        class="branch-option"
                        data-branch="Bohol">

                    <div class="branch-option-icon">

                        <i class="bi bi-building"></i>

                    </div>

                    <div class="branch-option-info">

                        <div class="branch-option-name">

                            Bohol

                        </div>

                        <div class="branch-option-location">

                            Bohol Branch

                        </div>

                    </div>

                    <i class="bi bi-check2 branch-check"></i>

                </button>


            </div>

        </div>

    </div>


    <div class="sidebar-content">


        <div class="menu-label">

            MAIN

        </div>
        

        <!-- DASHBOARD -->

        <a href="#"
           class="sidebar-item ">

            <i class="bi bi-speedometer2"></i>

            <span>
                Dashboard
            </span>

        </a>

        <!-- MASTER DATA -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-item sidebar-dropdown">

                <i class="bi bi-database"></i>

                <span>
                    Master Data
                </span>

                <i class="bi bi-chevron-right menu-arrow"></i>

            </button>


            <div class="submenu">


                <a href="#"
                   class="submenu-item">

                    <i class="bi bi-truck"></i>

                    <span>
                        Supplier
                    </span>

                </a>
            </div>

        </div>
        <a href="#"
           class="sidebar-item">

            <i class="bi bi-clipboard2-data"></i>

            <span>
                Chart of Accounts
            </span>

        </a>

        <!-- TRANSACTIONS -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-item sidebar-dropdown">

                <i class="bi bi-arrow-left-right"></i>

                <span>
                    Transactions
                </span>

                <i class="bi bi-chevron-right menu-arrow"></i>

            </button>


            <div class="submenu">


                <a href="#"
                   class="submenu-item">

                    <i class="bi bi-receipt"></i>

                    <span>
                        Account Reconciliation
                    </span>

                </a>


                <a href="#"
                   class="submenu-item">

                    <i class="bi bi-credit-card"></i>

                    <span>
                        Check Register
                    </span>

                </a>


                <a href="#"
                   class="submenu-item">

                    <i class="bi bi-pencil-square"></i>

                    <span>
                        Adjustment
                    </span>

                </a>


            </div>

        </div>



        <!-- REPORTS -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-item sidebar-dropdown">

                <i class="bi bi-bar-chart"></i>

                <span>
                    Reports
                </span>

                <i class="bi bi-chevron-right menu-arrow"></i>

            </button>


            <div class="submenu">


                <a href="#"
                   class="submenu-item">

                    <i class="bi bi-graph-up"></i>

                    <span>
                        Sales Report
                    </span>

                </a>


                <a href="#"
                   class="submenu-item">

                    <i class="bi bi-calculator"></i>

                    <span>
                        Accounting Report
                    </span>

                </a>


            </div>

        </div>



        <div class="menu-label">

            SYSTEM

        </div>


        <!-- SETTINGS -->

        <a href="#"
           class="sidebar-item">

            <i class="bi bi-gear"></i>

            <span>
                Settings
            </span>

        </a>


        <!-- USERS -->

        <div class="sidebar-group">


            <button type="button"
                    class="sidebar-item sidebar-dropdown">

                <i class="bi bi-people"></i>

                <span>
                    Administrator
                </span>

                <i class="bi bi-chevron-right menu-arrow"></i>

            </button>

            <div class="submenu">

                <a asp-action="User_Index" asp-controller="User"
                   class="submenu-item">

                    <i class="bi bi-person"></i>

                    <span>
                        User Account
                    </span>

                </a>

                <a asp-action="Access_Index" asp-controller="UserAccess"
                   class="submenu-item">

                    <i class="bi bi-sliders"></i>

                    <span>
                        User Access
                    </span>

                </a>
                <a class="submenu-item">

                    <i class="bi bi-share-fill"></i>

                    <span>
                        Branch
                    </span>

                </a>

            </div>

        </div>


    </div>



    <!-- FOOTER -->

    <div class="sidebar-footer">


        <a asp-controller="Login" asp-action="Logout"
           class="sidebar-item-footer ">

            <i class="bi bi-box-arrow-right"></i>

            <span>
               LOG OUT - @fullname 
            </span>

        </a>


    </div>


</aside>
