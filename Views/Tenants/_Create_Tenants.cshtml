@using Ams_Web.Models;
@model tenants_ViewModel

<div class="modal fade"
     id="createtenants"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ">
        <form asp-action="Create_Tenants" id="frmcreatetenants">
            <div class="modal-container">
                <div class="modal-wrapper">
                    <div class="card modal-content">
                        <div class="card-header">
                            <h2 class="card-title">
                                New Tenants
                            </h2>
                            <p class="card-description">
                                Enter the Tenant's  information .
                            </p>
                        </div>
                        <div class="card-body">
                            <div class="form-section">
                                <div class="section-title">
                                    <i class="bi bi-person-badge"></i>
                                    Tenants Information
                                </div>
                                <div class="form-grid">

                                    <div class="form-group">
                                        <label asp-for="_tenantsCreate.Tin"> </label>
                                        <input type="text" class="gray-input"
                                               asp-for="_tenantsCreate.Tin"
                                               id="createtenantstin"
                                               placeholder="000-000-000"
                                               maxlength="11"
                                               inputmode="numeric" readonly />
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="_tenantsCreate.TinCode"> </label>
                                        <input type="text" class="gray-input"
                                               asp-for="_tenantsCreate.TinCode"
                                               id="createtenantstincode"
                                               placeholder="0000"
                                               maxlength="4"
                                               inputmode="numeric" readonly />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="_tenantsCreate.Type"> </label>
                                    <select asp-for="_tenantsCreate.Type" class="w-100"
                                            id="tenantsttypeid"
                                            onchange="Create_Show_Selected_Tenants_Type()">
                                        <option value=""></option>
                                        <option value="1">Individual</option>
                                        <option value="2">Corporation</option>
                                    </select>
                                </div>
                                <div id="tenantsindividualdiv">
                                    <div class="form-grid">
                                        <div class="form-group">
                                            <label asp-for="_tenantsCreate.Firstname"> </label>
                                            <input type="text" id="tenantsfname"
                                                   asp-for="_tenantsCreate.Firstname"
                                                   placeholder="Juan" />
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="_tenantsCreate.Lastname"> </label>
                                            <input type="text" id="tenantslname"
                                                   asp-for="_tenantsCreate.Lastname"
                                                   placeholder="Dela Cruz" />
                                        </div>
                                    </div>
                                    <div class="form-grid">
                                        <div class="form-group">
                                            <label asp-for="_tenantsCreate.Middlename"> </label>
                                            <input type="text" id="tenantsmname"
                                                   asp-for="_tenantsCreate.Middlename"
                                                   maxlength="1"
                                                   placeholder="Dela Cruz" />
                                        </div>
                                    </div>
                                </div>

                                <div id="tenantscorporationdiv">
                                    <div class="form-group">
                                        <label asp-for="_tenantsCreate.Corporation"> </label>
                                        <input type="text" id="tenantscorporation"
                                               asp-for="_tenantsCreate.Corporation"
                                               placeholder="Juan Corporation" />
                                    </div>

                                </div>
                                <div class="form-group">
                                    <label asp-for="_tenantsCreate.AddressDetails"> </label>
                                    <textarea type="text" placeholder="Looc"
                                              asp-for="_tenantsCreate.AddressDetails"></textarea>
                                </div>
                                <div class="form-group">
                                    <label asp-for="_tenantsCreate.City"> </label>
                                    <input type="text" placeholder="Mandaue City"
                                              asp-for="_tenantsCreate.City"/>
                                </div>
                                <div class="form-group">
                                    <label asp-for="_tenantsCreate.Zipcode"> </label>
                                    <input type="text" class="w-25" id="tenantszipcode"
                                           maxlength="4" placeholder="6***"
                                           asp-for="_tenantsCreate.Zipcode" />
                                </div>
                            </div>
                            <div class="card-footer">
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Cancel
                                </button>
                                <div id="tenantssavebuttondiv">
                                    <button type="submit" id="btncreatetenants"
                                            class="btn btn-primary">
                                        <i class="bi bi-person-fill-add"></i>
                                        Create Tenants
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>