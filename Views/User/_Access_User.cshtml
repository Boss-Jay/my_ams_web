@using Ams_Web.Models;
@model user_ViewModel
<div class="modal fade"
     id="useraccess"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ">
        <div class="page-container">
            <div class="registration-wrapper">
                <!-- CARD -->
                <div class="card modal-content">
                    <!-- CARD HEADER -->
                    <div class="card-header">
                        <h2 class="card-title">
                            Account Access - <span id="accessfullname"></span>
                        </h2>
                        <p class="card-description">
                            User's personal information and system access.
                        </p>

                    </div>
                    <input id="accessuserid" hidden />
                    <div class="card-body">
                        <div class="section-title">
                            <i class="bi bi-card-list"></i>
                            Access List
                        </div>
                        <div class="table-responsive accesstable-scroll" >

                            <table class="table table-hover table-borderless align-middle" id="userAccessTable">

                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>#</th>
                                        <th style="width:100%;">Module Name</th>
                                        <th class="text-center"> All Access
                                            <input type="checkbox"
                                                   id="checkAllUsers"
                                                   class="form-check-input">
                                        </th>
                                    </tr>
                                </thead>

                                <tbody id="moduleAccessTable">
                                    @foreach (var item in Model._accessModule_Dtos!)
                                    {
                                        <tr>
                                            <td class="w-auto">
                                                @item!.Id
                                            </td>
                                            <td class="w-auto">
                                                @item!.Module
                                            </td>
                                            <td class="text-end">
                                                <input type="checkbox" 
                                                    class="form-check-input row-checkbox"
                                                value="@item.Id">
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- CARD FOOTER -->
                    <div class="card-footer d-flex justify-content-end gap-2">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>
                            Cancel
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                id="btnsaveAccess"
                                onclick="Save_Access()">
                            <i class="bi bi-check-circle me-1"></i>
                            Save Access
                        </button>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>