
<div class="modal fade"
     id="useraccess"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ">
        <div class="page-container">
            <div class="registration-wrapper">
                <!-- CARD -->
                <div class="card modal-content">
                    <!-- CARD HEADER -->
                    <div class="card-header">
                        <h2 class="card-title">
                            Account Access - <span id="accessfullname"></span>
                        </h2>
                        <p class="card-description">
                            User's personal information and system access.
                        </p>

                    </div>
                    <input id="accessuserid" hidden />
                    <div class="card-body">
                        <div class="section-title">
                            <i class="bi bi-card-list"></i>
                            Module List
                        </div>
                        <div class="table-responsive">

                            <table class="table table-hover table-bordered align-middle">

                                <thead class="table-light">
                                    <tr>
                                        <th style="width:100%;">Module Name</th>
                                        <th class="text-center">Access</th>
                                      
                                    </tr>
                                </thead>

                                <tbody id="moduleAccessTable">

                                    <tr>
                                        <td>
                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Dashboard
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   name="access[dashboard][view]"
                                                   checked />
                                        </td>
                                   
                                
                                    </tr>

                                    <tr>
                                        <td>
                                            <i class="bi bi-people me-2"></i>
                                            User Management
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   name="access[users][view]" />
                                        </td>
                                       
                                    </tr>

                                    <tr>
                                        <td>
                                            <i class="bi bi-building me-2"></i>
                                            Branch Management
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   name="access[branches][view]" />
                                        </td>
                                     
                                    </tr>

                                    <tr>
                                        <td>
                                            <i class="bi bi-journal-text me-2"></i>
                                            Transactions
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   name="access[transactions][view]" />
                                        </td>
                                     
                                    </tr>

                                    <tr>
                                        <td>
                                            <i class="bi bi-bar-chart me-2"></i>
                                            Reports
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   name="access[reports][view]" />
                                        </td>
                                    
                             
                                    </tr>

                                </tbody>

                            </table>
                        </div>

                    </div>

                    <!-- CARD FOOTER -->
                    <div class="card-footer d-flex justify-content-end gap-2">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>
                            Cancel
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                id="saveUserAccess">
                            <i class="bi bi-check-circle me-1"></i>
                            Save Access
                        </button>

                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>