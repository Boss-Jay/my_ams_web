@using Ams_Web.Models;
@model user_ViewModel

<div class="modal fade"
     id="createuser"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ">

        <form asp-action="Create_User" method="post" id="frmusercreate">
            <div class="page-container">
                <div class="registration-wrapper">
                    <!-- CARD -->
                    <div class="card modal-content">
                        <!-- CARD HEADER -->
                        <div class="card-header">
                            <h2 class="card-title">
                                Account Information
                            </h2>
                            <p class="card-description">
                                Enter the user's personal information and system access.
                            </p>

                        </div>


                        <!-- CARD BODY -->
                        <div class="card-body">

                            <!-- PERSONAL INFORMATION -->
                            <div class="form-section">

                                <div class="section-title">
                                    <i class="bi bi-person"></i>
                                    Personal Information
                                </div>

                                <div class="form-grid">

                                    <div class="form-group">
                                        <label asp-for="_userCreate_Dto.Firstname"> </label>
                                        <input asp-for="_userCreate_Dto.Firstname" id="userfname"
                                               placeholder="Juan">
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="_userCreate_Dto.Middlename"></label>
                                        <input asp-for="_userCreate_Dto.Middlename" id="usermname"
                                               placeholder="Borgos">
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="_userCreate_Dto.Lastname"></label>
                                        <input asp-for="_userCreate_Dto.Lastname" id="userlname"
                                               placeholder="Dela Cruz">
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="_userCreate_Dto.Suffix"></label>
                                        <input asp-for="_userCreate_Dto.Suffix"
                                               placeholder="II III JR SR">

                                    </div>

                                </div>

                            </div>


                            <!-- LOGIN INFORMATION -->
                            <div class="form-section">

                                <div class="section-title">
                                    <i class="bi bi-shield-lock"></i>
                                    Login Information
                                </div>

                                <div class="form-grid">

                                    <div class="form-group">

                                        <label asp-for="_userCreate_Dto.Username"></label>
                                        <input asp-for="_userCreate_Dto.Username" id="userusername"
                                               placeholder="jbdelacruz">
                                           
                                    </div>

                                </div>

                            </div>


                            <!-- SYSTEM ACCESS -->
                            <div class="form-section">

                                <div class="section-title">
                                    <i class="bi bi-diagram-3"></i>
                                    System Access
                                </div>

                                <div class="form-grid">

                                    <div class="form-group">

                                        <label asp-for="_userCreate_Dto.RoleId"></label>

                                        <select asp-for="_userCreate_Dto.RoleId"
                                                asp-items="ViewBag.vbrole">
                                            <option value="">
                                                Select role
                                            </option>
                                        </select>

                                    </div>


                                    <div class="form-group">

                                        <label asp-for="_userCreate_Dto.Branchid"></label>

                                        <select asp-for="_userCreate_Dto.Branchid"
                                                asp-items="ViewBag.vbbranch">
                                            <option value="">
                                                Select role
                                            </option>
                                        </select>

                                    </div>


                                </div>

                            </div>

                        </div>
                        <!-- FOOTER -->
                        <div class="card-footer">

                            <button type="button"
                                    class="btn btn-cancel "
                                    data-bs-dismiss="modal"
                                    onclick="closeUserModal()" aria-label="Close">
                                Cancel
                            </button>

                            <button type="submit" id="btnusercreate"
                                    class="btn btn-primary">
                                <i class="bi bi-person-plus"></i>
                                Create User
                            </button>

                        </div>

                    </div>

                </div>

            </div>
        </form>

    </div>
</div>